{
  "name": "fvl-back-patients",
  "version": "1.0.0",
  "description": "Plantilla base de backend FVL: Express 5, TypeScript y SQL Server con TypeORM",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:local:up": "docker compose -f docker-compose.local.yml up -d --wait",
    "db:local:down": "docker compose -f docker-compose.local.yml down"
  },
  "dependencies": {
    "@hapi/boom": "10.0.1",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-validator": "7.3.2",
    "helmet": "8.3.0",
    "mssql": "12.7.14",
    "reflect-metadata": "0.2.2",
    "swagger-ui-express": "5.0.1",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
