# Ambiente: dev, qas o prd. Va en la URL del API; no es NODE_ENV
ENV=dev
# Puerto en el que escucha Node
PORT=3000
# Primer segmento de la URL del API
API_BASE_URL=backend
# Version del API en la URL
API_VERSION=v1
# Origenes que pueden leer respuestas desde un navegador, separados por coma. Vacio: ninguno
ALLOWED_ORIGINS=
# Servidor SQL Server
MAIN_DB_HOST=127.0.0.1
# Puerto de SQL Server
MAIN_DB_PORT=1433
# Usuario propio de la aplicacion; nunca el administrador
MAIN_DB_USER=
# Contrasena del usuario. Con la base local crea el usuario sa: 8 o mas caracteres con mayusculas, minusculas y numeros
MAIN_DB_PASSWORD=
# Nombre de la base de datos
MAIN_DB_NAME=
